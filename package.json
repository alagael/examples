{
  "name": "@alagael/examples",
  "version": "0.1.0",
  "description": "Read-only Ethereum factory inspection and disposable cryptographic examples. No deployment keys, wallet connection service, or production app.",
  "type": "module",
  "license": "MIT",
  "author": "Alagael contributors",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.17.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/alagael/examples.git"
  },
  "bugs": {
    "url": "https://github.com/alagael/examples/issues"
  },
  "homepage": "https://github.com/alagael/examples#readme",
  "files": [
    "dist",
    "src",
    "vendor",
    "abi",
    "deployments",
    "examples",
    "assets",
    "build.mjs",
    "scripts",
    "test",
    "lib",
    "foundry.toml",
    "pnpm-lock.yaml",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "RELEASING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "scripts": {
    "build": "node --check src/index.js && node --check examples/inspect-factory.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "alagael",
    "ethereum",
    "privacy",
    "inheritance"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  }
}
